rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /pas_jawaban/{docId} {
      // Siswa boleh memeriksa apakah dirinya sudah mengirim (baca satu dokumen saja).
      allow get: if true;

      // Daftar semua jawaban hanya untuk guru yang sudah login.
      allow list: if request.auth != null;

      // Siswa mengirim jawaban SEKALI. Tidak boleh menyertakan nilai.
      allow create: if request.resource.data.keys().hasOnly(
                         ['mapel','kelas','absen','nama','jawaban','nilai_manual','status','mulai_at','dikirim_at'])
                    && docId == (request.resource.data.mapel + '_' + request.resource.data.kelas + '_' + string(request.resource.data.absen)).replace('[^A-Za-z0-9_-]', '-')
                    && request.resource.data.nilai_manual.size() == 0
                    && request.resource.data.status == 'belum'
                    && request.resource.data.nama is string
                    && request.resource.data.nama.size() <= 80
                    && request.resource.data.absen is int
                    && request.resource.data.jawaban is map
                    && exists(/databases/$(database)/documents/pas_masuk/$(docId));

      // Menilai dan menghapus hanya guru yang sudah login.
      allow update, delete: if request.auth != null;
    }

    // Draft jawaban (tersimpan per soal) selama siswa mengerjakan.
    // Tidak bisa diubah lagi setelah jawaban final dikirim, kecuali oleh guru.
    match /pas_draft/{docId} {
      allow get: if true;
      allow list: if request.auth != null;
      allow create, update: if request.auth != null || (
           !exists(/databases/$(database)/documents/pas_jawaban/$(docId))
        && exists(/databases/$(database)/documents/pas_masuk/$(docId))
        && request.resource.data.keys().hasOnly(
             ['mapel','kelas','absen','nama','mulai','jawaban','ragu','idx','urutan','terjawab','total','diperbarui_at'])
        && docId == (request.resource.data.mapel + '_' + request.resource.data.kelas + '_' + string(request.resource.data.absen)).replace('[^A-Za-z0-9_-]', '-')
        && request.resource.data.absen is int
        && request.resource.data.jawaban is map
        && (resource == null || resource.data.mulai == null || resource.data.mulai == request.resource.data.mulai));
      allow delete: if request.auth != null
        || exists(/databases/$(database)/documents/pas_jawaban/$(docId));
    }

    // Token ujian per mapel: hanya guru yang bisa membaca & mengubah.
    match /pas_token/{mapel} {
      allow read, write: if request.auth != null;
    }

    // Bukti siswa sudah memasukkan token yang benar (diperiksa di sini, token tidak pernah terbaca siswa).
    match /pas_masuk/{docId} {
      allow read, delete: if request.auth != null;
      allow create, update: if request.auth != null || (
           request.resource.data.keys().hasOnly(['mapel','kelas','absen','nama','token','waktu'])
        && docId == (request.resource.data.mapel + '_' + request.resource.data.kelas + '_' + string(request.resource.data.absen)).replace('[^A-Za-z0-9_-]', '-')
        && request.resource.data.absen is int
        && exists(/databases/$(database)/documents/pas_token/$(request.resource.data.mapel))
        && get(/databases/$(database)/documents/pas_token/$(request.resource.data.mapel)).data.aktif == true
        && get(/databases/$(database)/documents/pas_token/$(request.resource.data.mapel)).data.token == request.resource.data.token);
    }

    // Daftar siswa per rombel: dibaca halaman siswa, diubah hanya oleh guru.
    match /pas_siswa/{kelas} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
